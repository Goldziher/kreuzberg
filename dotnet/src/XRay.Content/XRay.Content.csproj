<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XRay.Content</RootNamespace>
    <AssemblyName>XRay.Content</AssemblyName>

    <!-- NuGet package metadata. The package id is hyphenated; the assembly and namespace are
         not, because a hyphen is not valid in a C# identifier. -->
    <PackageId>X-Ray.Content</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>Curiosity GmbH</Authors>
    <Description>The content-extraction package of the X-Ray family of .NET libraries: a pure-managed engine, ported natively to C# from the Rust `xberg` engine. The API lives under the `XRay.Content` namespace. Extracts text, metadata, tables and structured content from Office documents, PDF, HTML, email, archives and more. Extraction itself is pure managed; the optional OCR pass is off by default and brings native dependencies (SkiaSharp, PDFium) when enabled.</Description>
    <!-- Not plain MIT: three ported Rust crates are Apache-2.0 only. See
         THIRD_PARTY_NOTICES.md for which files and why. -->
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>document;extraction;pdf;docx;xlsx;pptx;text;markdown;html</PackageTags>
    <RepositoryUrl>https://github.com/curiosity-ai/x-ray-content</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/curiosity-ai/x-ray-content/tree/main/dotnet</PackageProjectUrl>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The X-Ray.Psd version PsdExtractor builds against (the family's PSD/PSB reader, published
         from curiosity-ai/x-ray-others). THIS MUST BE SET TO THE FIRST PUBLISHED VERSION: until
         X-Ray.Psd is on nuget.org, the placeholder below resolves only from a local feed, so a
         restore anywhere else fails loudly rather than picking up something unintended. Change
         this one line; nothing else names the version. For a local build against an unpublished
         package, pack it and pass the feed and version on the command line:
           dotnet pack <x-ray-psd>/src/XRay.Psd -c Release -p:PackageId=X-Ray.Psd -p:Version=0.1.0-local -o <feed>
           dotnet build dotnet/XRay.Content.sln -p:RestoreAdditionalProjectSources=<feed>
         (or export RestoreAdditionalProjectSources=<feed>). Its core takes no dependencies, so
         this keeps extraction pure managed. -->
    <XRayPsdVersion Condition="'$(XRayPsdVersion)' == ''">0.1.0-local</XRayPsdVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- The file PackageIcon above names; it has to be in the package for the icon to show.
         The README does not point at this copy: nuget.org renders neither relative image
         paths nor raw HTML, so it links the logo by absolute raw.githubusercontent.com URL
         (an allow-listed domain) instead. -->
    <None Include="logo.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XRay.Content.Tests" />
    <!-- Matches the tool's AssemblyName, not its project name. -->
    <InternalsVisibleTo Include="xray-content-onnx-parity" />
    <InternalsVisibleTo Include="xray-content-bench" />
    <InternalsVisibleTo Include="xray-content-testrunner" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.Fonts" Version="2.0.9" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.11" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
    <!-- PSD/PSB structure and text; see XRayPsdVersion above. -->
    <PackageReference Include="X-Ray.Psd" Version="$(XRayPsdVersion)" />
    <!-- The optional OCR pass; see the OCR section of CLAUDE.md. `PaddleOCR` is a managed
         recognizer whose only native dependency is SkiaSharp; `PaddleOCR.Pdf` adds PDFium, which
         is what rasterises a scanned page so ScanOnly has pixels to read. Both load lazily and
         only once a caller turns OCR on.

         Keep the two on the same version, and prefer bumping them together with a rebuild:
         `PdfRasterizer.Render` gained an optional `maxPagePixels` parameter in 26.9.5064, which
         is source-compatible but *not* binary-compatible — an assembly compiled against 26.8.4668
         calls a four-argument overload that no longer exists, so a consumer whose graph resolves
         the newer package gets a MissingMethodException inside ScanOnly. OCR is never fatal here,
         so that surfaces as a processing warning and a scanned page that silently reads empty. -->
    <PackageReference Include="PaddleOCR" Version="26.9.5064" />
    <PackageReference Include="PaddleOCR.Pdf" Version="26.9.5064" />
  </ItemGroup>

</Project>
