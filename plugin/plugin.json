{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "xberg",
  "version": "1.3.11",
  "description": "Local document extraction: text, tables, metadata, images from 107 formats with optional OCR.",
  "author": {
    "name": "Kreuzberg, Inc.",
    "email": "contact@xberg.io",
    "url": "https://xberg.io"
  },
  "homepage": "https://xberg.io",
  "repository": "https://github.com/xberg-io/xberg",
  "license": "MIT",
  "keywords": [
    "document-intelligence",
    "extraction",
    "ocr",
    "pdf",
    "tables"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "brandColor": "#1F6FEB",
        "capabilities": [
          "Read"
        ],
        "category": "document-intelligence",
        "composerIcon": "./assets/icon.svg",
        "defaultPrompt": [
          "Extract text from this PDF",
          "OCR a scanned image",
          "List supported formats"
        ],
        "developerName": "Kreuzberg, Inc.",
        "displayName": "Xberg",
        "logo": "./assets/logo.png",
        "longDescription": "Extract text, tables, metadata, and images from PDFs, Office files, images, HTML, email, archives, and academic formats. Runs locally via the xberg CLI and an auto-registered MCP server. Plugin ships skills covering the CLI surface, OCR backends, table extraction, and output-format selection.",
        "privacyPolicyURL": "https://xberg.io/privacy",
        "shortDescription": "Local document extraction for 107 formats",
        "termsOfServiceURL": "https://xberg.io/terms",
        "websiteURL": "https://xberg.io"
      }
    }
  }
}
