{
  "name": "@xberg-io/llamaindex-xberg",
  "version": "1.3.11",
  "description": "LlamaIndex.TS reader and node parser for Xberg — extract text, tables, metadata, and structure-aware nodes from 107 document formats with optional OCR.",
  "keywords": [
    "llamaindex",
    "llama-index",
    "xberg",
    "document-extraction",
    "rag",
    "reader",
    "node-parser",
    "ocr",
    "pdf",
    "text-extraction"
  ],
  "license": "MIT",
  "homepage": "https://github.com/xberg-io/xberg/tree/main/integrations/node/llamaindex-xberg",
  "author": {
    "name": "Na'aman Hirschfeld",
    "email": "naaman@xberg.io"
  },
  "contributors": [
    {
      "name": "Tobias Perlstein",
      "email": "tobias@xberg.io"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xberg-io/xberg.git",
    "directory": "integrations/node/llamaindex-xberg"
  },
  "engines": {
    "node": ">=20.15"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xberg-io/xberg": "1.3.11"
  },
  "peerDependencies": {
    "@llamaindex/core": "^0.6.0"
  },
  "devDependencies": {
    "@llamaindex/core": "^0.6.23",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
