{
  "name": "@xberg-io/langchain-xberg",
  "version": "1.4.0",
  "description": "LangChain.js document loader for Xberg — extract text, tables, and metadata from 107 document formats with optional OCR.",
  "keywords": [
    "langchain",
    "langchainjs",
    "document-loader",
    "xberg",
    "document-extraction",
    "ocr",
    "pdf",
    "text-extraction",
    "rag"
  ],
  "license": "MIT",
  "homepage": "https://github.com/xberg-io/xberg/tree/main/integrations/node/langchain-xberg",
  "author": {
    "name": "Na'aman Hirschfeld",
    "email": "naaman@xberg.io"
  },
  "contributors": [
    {
      "name": "Tobias Perlstein",
      "email": "tobias@xberg.io"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xberg-io/xberg.git",
    "directory": "integrations/node/langchain-xberg"
  },
  "engines": {
    "node": ">=20.15"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xberg-io/xberg": "1.4.0",
    "fast-glob": "^3.3.3"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0 <2"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.18",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
